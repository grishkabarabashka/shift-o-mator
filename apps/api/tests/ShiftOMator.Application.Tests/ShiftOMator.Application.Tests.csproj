<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ShiftOMator.Domain\ShiftOMator.Domain.csproj" />
    <ProjectReference Include="..\..\src\ShiftOMator.Application\ShiftOMator.Application.csproj" />
    <ProjectReference Include="..\..\src\ShiftOMator.Infrastructure\ShiftOMator.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- FixtureSeeder reads Seed/fixture-dataset.json relative to AppContext.BaseDirectory;
         Infrastructure's own CopyToOutputDirectory item doesn't propagate across a
         ProjectReference, so it's declared here too. -->
    <None Include="..\..\src\ShiftOMator.Infrastructure\Seed\fixture-dataset.json" Link="Seed\fixture-dataset.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Phase8Baseline\baseline.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>