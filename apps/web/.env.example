# Copy to `.env.development.local` (git-ignored) and fill in.
#
# Every VITE_* value is inlined into the JS bundle at build time — it is not read at
# container start. A deployed web image therefore carries the environment it was built
# for; see apps/web/Dockerfile and deploy/README.md.
#
# None of these are secrets. A SPA client id and a scope are public by design: the
# security boundary is the redirect URI registered in Entra plus the token the API
# validates, never the confidentiality of these strings.

# Where the API lives.
VITE_API_URL=http://localhost:5106

# `stub` (default) — the API issues an identity without reading a token, and the in-app
#   identity switcher appears. No Entra setup needed. This is the normal local loop.
# `entra` — sign in for real. Requires the four settings below and an app registration;
#   the server must also be running Auth:Mode=EntraId, or it will ignore the token and
#   the switcher will reappear.
VITE_AUTH_MODE=stub

# Required only when VITE_AUTH_MODE=entra. See deploy/README.md,
# "Entra ID for local development", for how to obtain each.
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
# The scope exposed by the API's app registration — NOT a Graph scope. A Graph token has
# the wrong audience and every call comes back 401.
VITE_ENTRA_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user
# Optional: defaults to the current origin, which is what local dev wants. Whatever it
# resolves to must be registered as a SPA redirect URI on the app registration.
VITE_ENTRA_REDIRECT_URI=
