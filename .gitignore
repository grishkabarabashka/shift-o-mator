# Артефакты сборки и инструментов — только в корне.
#
# Пути якорятся слэшем в начале намеренно: незаякоренный `coverage/` совпадал с
# `src/features/coverage/` и молча выкинул из репозитория полосу покрытия.
/node_modules/
/dist/
/coverage/
/.vite/
*.local
.DS_Store
Thumbs.db
.env
.env.*
!.env.example
*.tsbuildinfo
/.idea/
/.vscode/*
!/.vscode/extensions.json

# .NET backend — build output, not source. Unanchored on purpose: bin/obj recur
# under every project (api/src/*/bin, api/tests/*/obj, ...).
bin/
obj/
*.user
